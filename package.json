{
  "name": "@zzusp/agent-channel-host",
  "version": "1.1.0",
  "description": "An event-driven Channel host for isolated, resumable agent runtime conversations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/agent-channel-host.git"
  },
  "homepage": "https://github.com/HiQ-AI/agent-channel-host#readme",
  "bugs": {
    "url": "https://github.com/HiQ-AI/agent-channel-host/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["dingtalk", "channel", "codex", "agent", "runtime"],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agent-channel": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
